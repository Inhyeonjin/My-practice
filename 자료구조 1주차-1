#include <iostream>
#include <string>
using namespace std;

int main()
{
	int T;					//명령어 갯수
	int N;					//배열의 크기
	cin >> T >> N;
	int* arr = new int[N] {} ;			// T사이즈 만큼의 배열 동적 생성 , 0으로 모두 초기화

	string command;					//명령어
	
	for (int i = 0; i < T; i++)
	{
		cin >> command;
		if (command == "at")
		{
			int index;
			cin >> index;
			cout << arr[index] << endl;
		}

		else if (command == "add")
		{
			int i;
			int z;
			cin >> i >> z;
			for (int j = N-2; j >=i; j--)
			{
				arr[j + 1] = arr[j];
			}
			arr[i] = z;

		}

		else if (command == "remove")
		{
			int i;
			cin >> i;
			for (int j = N-1; j >=i+1; j--)
			{
				arr[j] = arr[j-1];
			}
			arr[N -1] = 0;


		}

		else if (command == "set")
		{
			int i;
			int z;
			cin >> i >> z;
			arr[i] = z;

		}
		else if (command == "find_max")
		{
			int max = arr[0];

			for (int j = 1; j <N; j++)
			{
				if (arr[j] > max)
					max = arr[j];

			}
			cout << max << endl;
		}

		else if (command == "print")
		{
			for (int j = 0; j < N; j++)
			{
				cout << arr[j] << " ";
			}
			cout << endl;
		}


	}
	delete[] arr;			//동적할당은 delete로 해제 시켜주기
}
